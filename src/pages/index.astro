---
import Layout from '../layouts/Layout.astro';
import products from '../data/products.json';
import { rankProducts } from '../utils/curation.js';
import { rankProductsV8 } from '../utils/mallora-intelligence.js';
import MalloraSearch from '../components/MalloraSearch.astro';

const rankedProducts = rankProductsV8(rankProducts(products)).filter(product => product.featured);
---

<Layout title="MALLORA | Descubra melhor. Compre com inteligência.">
  <main class="mallora">
    <div class="announcement">
      CURADORIA INTELIGENTE • GRANDES DESCOBERTAS
    </div>

    <header class="header">
      <a href="/" class="brand">
        <span class="brand-mark">M</span>
        <span>MALLORA<span class="gold">.</span></span>
      </a>

      <nav>
        <a href="/categorias">Categorias</a>
        <a href="/ofertas">Ofertas</a>
        <a href="/about">Sobre</a>
      </nav>

      <a href="/ofertas" class="header-cta">Explorar <span>↗</span></a>
    </header>

    <section class="hero">
      <div class="hero-content">
        <span class="eyebrow"><span></span> SUA NOVA EXPERIÊNCIA DE COMPRAS</span>
        <h1>Descubra melhor.<br /><span>Compre com inteligência.</span></h1>
        <p>Encontramos produtos interessantes, oportunidades e descobertas que fazem sentido para o seu dia a dia.</p>
        <a href="/ofertas" class="primary-btn">Descobrir ofertas <span>→</span></a>
        <div class="hero-note">Curadoria de produtos • Descobertas • Inspiração</div>
      </div>

      <div class="hero-art">
        <div class="orbit orbit-one"></div>
        <div class="orbit orbit-two"></div>
        <div class="art-center">
          <span class="art-m">M</span>
          <span class="art-label">SMART<br />DISCOVERY</span>
        </div>
        <div class="floating-tag tag-top">✦ Seleção inteligente</div>
        <div class="floating-tag tag-bottom">MALLORA / 01</div>
      </div>
    </section>

    <section class="search-section">
      <span class="section-kicker">SMART DISCOVERY</span>
      <MalloraSearch />
      <p>Encontre produtos, marcas e descobertas.</p>
    </section>

    <section id="categorias" class="categories">
      <div>
        <span class="section-kicker">EXPLORE</span>
        <h2>O que você procura?</h2>
      </div>
      <div class="category-list">
        <a href="/categorias/tecnologia">⌂ Tecnologia</a>
        <a href="/categorias/casa-decoracao">◇ Casa & decoração</a>
        <a href="/categorias/estilo">✧ Estilo</a>
        <a href="/categorias/utilidades">▣ Utilidades</a>
        <a href="/categorias">＋ Mais descobertas</a>
      </div>
    </section>

    <section id="ofertas" class="offers">
      <div class="section-heading">
        <div>
          <span class="section-kicker">MALLORA SELECTION</span>
          <h2>Descobertas em destaque<span class="gold">.</span></h2>
          <p>Uma vitrine preparada para reunir produtos e oportunidades.</p>
        </div>
        <span class="selection-badge">CURADORIA</span>
      </div>

      <div class="product-grid">
        {rankedProducts.map((product) => (
          <article class="product-card">
            <div class="product-visual">
              {product.image ? <img src={product.image} alt={product.name} /> : <div class="product-placeholder">M</div>}
            <span>{product.category}</span>
          </div>
          <div class="product-info">
            <span class="product-category">{product.store || "MALLORA SELECTION"}</span>
            <h3><a href={`/produto/${product.slug || product.id}`}>{product.name}</a></h3>
            <p>{product.description}</p>
            {product.price !== null && <strong class="product-price">R$ {Number(product.price).toFixed(2).replace(".", ",")}</strong>}
            {product.affiliateUrl && <a href={product.affiliateUrl} target="_blank" rel="nofollow sponsored noopener">Ver oferta ↗</a>}
          </div>
          </article>
        ))}
      </div>
      {rankedProducts.length === 0 && (
        <div class="empty-catalog">
          <span>MALLORA CURADORIA</span>
          <h3>Estamos preparando novas descobertas para você.</h3>
          <p>Em breve, uma seleção especial de produtos e oportunidades.</p>
        </div>
      )}

      <div class="catalog-note">Seleção MALLORA: produtos publicados e links de parceiros.</div>
    </section>

    <section id="sobre" class="manifesto">
      <span class="section-kicker">NOSSO CONCEITO</span>
      <h2>Comprar melhor começa<br />com <span>descobrir melhor.</span></h2>
      <p>A MALLORA nasceu para tornar a descoberta de bons produtos mais simples, interessante e inteligente.</p>
      <div class="manifesto-signature">MALLORA<span class="gold">.</span> <span>SMART DISCOVERY</span></div>
    </section>

    <footer id="contato">
      <a href="/" class="brand footer-brand"><span class="brand-mark">M</span><span>MALLORA<span class="gold">.</span></span></a>
      <span>Descubra melhor. Compre com inteligência.</span>
      <small>© 2026 MALLORA • Alguns links poderão ser afiliados. Podemos receber comissão por compras elegíveis, sem custo adicional para você.</small>
    <a href="/metricas" class="mallora-metrics-link">MALLORA Intelligence</a></footer>
  </main>
</Layout>

<style>
  :global(body) { background:#0b1220; color:#f5f6fa; }
  .mallora { --navy:#0b1220; --panel:#111c2d; --gold:#d7b56d; --muted:#a7b0c1; background:var(--navy); color:#f5f6fa; font-family:system-ui,sans-serif; }
  .gold { color:var(--gold); }
  .announcement { text-align:center; padding:11px; background:#101a2a; color:var(--gold); font-size:10px; letter-spacing:2px; border-bottom:1px solid #263247; }
  .header { min-height:82px; padding:0 7%; display:flex; align-items:center; justify-content:space-between; border-bottom:1px solid #263247; gap:20px; }
  .brand { display:flex; align-items:center; gap:12px; font-weight:800; letter-spacing:3px; font-size:19px; }
  .brand-mark { display:grid; place-items:center; width:38px; height:38px; border:1px solid var(--gold); color:var(--gold); font-family:Georgia,serif; font-size:25px; }
  nav { display:flex; gap:32px; color:#c5ccda; font-size:13px; }
  nav a:hover { color:var(--gold); }
  .header-cta { border:1px solid #45516a; border-radius:30px; padding:12px 20px; font-size:12px; }
  .header-cta span { color:var(--gold); margin-left:10px; }
  .hero { padding:90px 8%; min-height:540px; display:grid; grid-template-columns:1.15fr 1fr; align-items:center; gap:40px; background:radial-gradient(ellipse at 80% 40%,#1c2a40 0%,#0b1220 60%); }
  .eyebrow,.section-kicker { color:var(--gold); letter-spacing:2px; font-size:10px; font-weight:700; }
  .eyebrow span { display:inline-block; width:22px; height:1px; background:var(--gold); margin-right:10px; vertical-align:middle; }
  h1 { font-size:clamp(38px,5.4vw,72px); line-height:1.08; letter-spacing:-2px; margin:25px 0; font-weight:600; }
  h1 span,.manifesto h2 span { color:var(--gold); }
  .hero-content>p { color:var(--muted); line-height:1.8; max-width:490px; font-size:15px; }
  .primary-btn { display:inline-flex; gap:35px; align-items:center; background:var(--gold); color:#101827; padding:16px 23px; border-radius:3px; margin-top:30px; font-weight:700; font-size:13px; }
  .primary-btn span { font-size:19px; }
  .hero-note { color:#7d899d; font-size:11px; margin-top:24px; }
  .hero-art { height:350px; position:relative; display:grid; place-items:center; }
  .orbit { position:absolute; border:1px solid #35435a; border-radius:50%; }
  .orbit-one { width:300px; height:300px; }
  .orbit-two { width:230px; height:230px; border-color:#7c6843; }
  .art-center { width:165px; height:165px; border-radius:50%; background:linear-gradient(145deg,#d8b96e,#8b6c35); color:#101827; display:flex; flex-direction:column; align-items:center; justify-content:center; box-shadow:0 0 70px #d7b56d22; }
  .art-m { font-family:Georgia,serif; font-size:75px; line-height:1; }
  .art-label { font-size:8px; letter-spacing:3px; text-align:center; margin-top:10px; }
  .floating-tag { position:absolute; background:#172338; border:1px solid #344158; padding:12px 16px; font-size:10px; color:#d9dfeb; letter-spacing:1px; }
  .tag-top { top:35px; right:0; }.tag-bottom { bottom:30px; left:0; color:var(--gold); }
  .categories { padding:55px 8%; background:#101a2a; border-top:1px solid #263247; border-bottom:1px solid #263247; }
  h2 { font-size:clamp(25px,3vw,40px); letter-spacing:-1px; margin:12px 0; }
  .category-list { display:flex; flex-wrap:wrap; gap:12px; margin-top:28px; }
  .category-list a { border:1px solid #344158; border-radius:30px; padding:12px 18px; font-size:12px; color:#c8d0df; }
  .category-list a:hover { border-color:var(--gold); color:var(--gold); }
  .offers { padding:85px 8%; }
  .section-heading { display:flex; justify-content:space-between; align-items:end; margin-bottom:35px; gap:20px; }
  .section-heading p { color:var(--muted); font-size:13px; margin-top:12px; }
  .selection-badge { color:var(--gold); border:1px solid #655536; padding:9px 13px; font-size:9px; letter-spacing:2px; }
  .product-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:22px; }
  .product-card { background:#111c2d; border:1px solid #263247; }
  .product-visual { height:230px; display:flex; align-items:center; justify-content:center; flex-direction:column; position:relative; font-family:Georgia,serif; font-size:34px; letter-spacing:5px; color:#d7b56d; }
  .product-visual img { width:100%; height:100%; object-fit:contain; padding:25px; position:absolute; }
  .product-placeholder { font-size:75px; color:#d7b56d; font-family:Georgia,serif; }
  .product-price { display:block; color:#f5f6fa; margin-top:12px; font-size:16px; }
  .product-visual span { position:absolute; top:18px; left:18px; font:10px system-ui; color:#8190a7; }
  .product-visual div { text-align:center; font-size:23px; line-height:1.3; }
  .visual-one { background:radial-gradient(circle,#273951,#111c2d 70%); }
  .visual-two { background:radial-gradient(circle,#3a3429,#111c2d 70%); }
  .visual-three { background:radial-gradient(circle,#27353c,#111c2d 70%); }
  .empty-catalog { text-align:center; padding:55px 20px; border:1px solid #263247; background:#111c2d; margin-bottom:30px; }
  .empty-catalog span { color:#d7b56d; font-size:10px; letter-spacing:3px; }
  .empty-catalog h3 { color:#f5f6fa; font-size:22px; margin:18px 0 10px; }
  .empty-catalog p { color:#8190a7; font-size:13px; }
  .product-info { padding:24px; }
  .product-category { color:var(--gold); font-size:9px; letter-spacing:2px; }
  .product-info h3 { font-size:18px; margin:12px 0; }
  .product-info p { color:var(--muted); font-size:12px; line-height:1.7; min-height:40px; }
  .product-info a { display:inline-block; color:var(--gold); font-size:12px; margin-top:20px; }
  .catalog-note { color:#738096; font-size:11px; margin-top:25px; }
  .manifesto { text-align:center; padding:100px 20px; background:#101a2a; border-top:1px solid #263247; }
  .manifesto h2 { font-size:clamp(30px,5vw,58px); line-height:1.2; margin:25px 0; }
  .manifesto>p { color:var(--muted); max-width:540px; margin:auto; line-height:1.8; font-size:14px; }
  .manifesto-signature { margin-top:40px; font-weight:800; letter-spacing:4px; }
  .manifesto-signature>span:last-child { font-size:9px; font-weight:400; letter-spacing:2px; color:#7f8ba0; margin-left:12px; }
  footer { padding:40px 8%; display:flex; align-items:center; flex-wrap:wrap; gap:25px; border-top:1px solid #263247; color:#9ba6b8; font-size:12px; }
  .footer-brand { color:#f5f6fa; }
  footer small { width:100%; line-height:1.6; color:#748096; font-size:10px; }
  @media(max-width:750px) {
    .header { padding:18px 6%; min-height:70px; flex-wrap:wrap; }
    nav { order:3; width:100%; justify-content:center; gap:22px; padding:10px 0; }
    .header-cta { font-size:11px; padding:10px 14px; }
    .hero { padding:65px 7%; grid-template-columns:1fr; gap:20px; }
    .hero-art { height:280px; }
    .orbit-one { width:250px;height:250px; }.orbit-two { width:190px;height:190px; }
    .art-center { width:140px;height:140px; }.art-m { font-size:60px; }
    .tag-top { right:5%; }.tag-bottom { left:5%; }
    .categories,.offers { padding:55px 6%; }
    .section-heading { align-items:start; flex-direction:column; }
    .product-grid { grid-template-columns:1fr; gap:18px; }
    .product-visual { height:210px; }
    .manifesto { padding:75px 7%; }
    footer { padding:35px 6%; }
  }
</style>

<style>
.search-section {
  padding: 42px 8%;
  text-align: center;
  background: #0b1220;
  border-bottom: 1px solid #263247;
}
.search-section > p {
  color: #9ba6b8;
  font-size: 12px;
  margin-top: 12px;
}
.search-section .section-kicker {
  color: #d7b56d;
  letter-spacing: 2px;
  font-size: 10px;
}
@media(max-width:600px) {
  .search-section { padding: 32px 6%; }
}
</style>
